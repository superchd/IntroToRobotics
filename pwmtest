#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver(0x40);

int channel = 0;

void setup() {
  Serial.begin(9600);

  pwm.begin();
  pwm.setPWMFreq(50);

  delay(500);

  Serial.println("PCA9685 Servo Calibration");
  Serial.println("Enter: pulse");
  Serial.println("Example: 375");
  Serial.println();
}

void loop() {

  if (Serial.available()) {

    int pulse = Serial.parseInt();

    while (Serial.available()) {
      Serial.read();
    }

    if (pulse >= 100 && pulse <= 650) {

      pwm.setPWM(channel, 0, pulse);

      Serial.print("CH");
      Serial.print(channel);
      Serial.print(" = ");
      Serial.println(pulse);

    } else {

      Serial.println("Enter a value between 100 and 650.");
    }
  }
}
